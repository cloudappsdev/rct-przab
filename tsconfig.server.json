{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@models/*": ["./src/generated/prisma/models/*"],
      "@prisma-client": ["./src/generated/prisma/client"]
    },
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["server", "src/lib", "src/generated"]
}
